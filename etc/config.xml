    payment_action is required: Payment::place() calls initialize() (which
    creates the Mollie payment) only when the method reports one.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <zero_mollie>
                <active>0</active>
                <model>Zero\Mollie\Model\Payment</model>
                <title>iDEAL, Bancontact, card, SEPA (Mollie)</title>
                <api_key backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <order_status>pending_payment</order_status>
                <payment_action>order</payment_action>
                <allowspecific>0</allowspecific>
                <sort_order>30</sort_order>
                <group>offline</group>
            </zero_mollie>
        </payment>
    </default>
</config>
